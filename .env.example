# =============================================================================
# MyOrg Backend — Production Environment
# =============================================================================
# Copy to .env.prod and fill in real values.
# Service names (db, redis, minio, ocr) are Docker-internal hostnames.
# =============================================================================

# Application
GOKIL_APP_NAME=myorg
GOKIL_ENV=production
GOKIL_DEBUG=false
GOKIL_HOST=0.0.0.0
GOKIL_PORT=8080

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED: Generate a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
GOKIL_DB_DRIVER=postgres
GOKIL_DB_HOST=db
GOKIL_DB_PORT=5432
GOKIL_DB_USER=myorg
GOKIL_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
GOKIL_DB_NAME=myorg
GOKIL_DB_DSN=postgres://myorg:CHANGE_ME_DB_PASSWORD@db:5432/myorg?sslmode=disable
GOKIL_DB_MIGRATIONS_DIR=migrations

# ── Redis ────────────────────────────────────────────────────────────────────
GOKIL_REDIS_ENABLED=true
GOKIL_REDIS_HOST=redis
GOKIL_REDIS_PORT=6379
GOKIL_REDIS_URL=redis://redis:6379/0

# ── Storage ──────────────────────────────────────────────────────────────────
# Option A: Local storage (files stored in Docker volume, served by backend)
GOKIL_STORAGE_PROVIDER=local
GOKIL_STORAGE_LOCAL_PATH=/data/storage

# Option B: MinIO / S3-compatible storage
# Uncomment below and comment out Option A above.
# When using S3, GOKIL_STORAGE_BASE_URL must be a PUBLIC-URL that the browser
# can reach (e.g. https://storage.myorg.com). Your reverse proxy must route
# that domain to the MinIO container port 9000.
#
# GOKIL_STORAGE_PROVIDER=s3
# GOKIL_STORAGE_BUCKET=myorg
# GOKIL_STORAGE_REGION=us-east-1
# GOKIL_STORAGE_ENDPOINT=minio:9000
# GOKIL_STORAGE_ACCESS_KEY_ID=CHANGE_ME_MINIO_USER
# GOKIL_STORAGE_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD
# GOKIL_STORAGE_BASE_URL=https://storage.myorg.com
# GOKIL_STORAGE_USE_SSL=false

# ── MinIO (only if using Option B) ───────────────────────────────────────────
# The values below are used by docker-compose.prod.yml for the MinIO container.
# They must match GOKIL_STORAGE_ACCESS_KEY_ID / SECRET_ACCESS_KEY above.
# GOKIL_STORAGE_ACCESS_KEY_ID=CHANGE_ME_MINIO_USER
# GOKIL_STORAGE_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD

# ── OCR Service ──────────────────────────────────────────────────────────────
OCR_LANG=ind+eng
OCR_PDF_DPI=200
# OCR_SERVICE_URL is set in docker-compose.prod.yml (http://ocr:8090)

# ── Seed Admin (optional — create initial admin on first run) ────────────────
# ADMIN_PASSWORD=changeme

# ── PostgreSQL (used by docker-compose for POSTGRES_* env vars) ──────────────
# These must match GOKIL_DB_* above.
# POSTGRES_USER and POSTGRES_DB are derived from GOKIL_DB_USER / GOKIL_DB_NAME
# in docker-compose.prod.yml; POSTGRES_PASSWORD = GOKIL_DB_PASSWORD.


# =============================================================================
# MyOrg Frontend — Production Environment
# =============================================================================
# Copy to .env.prod and fill in real values.
# =============================================================================

# Server-side: where Next.js SSR calls the backend (Docker service name).
# This is used by rewrites in next.config.ts and server-side apiRequest().
API_INTERNAL_URL=http://gokil:8080

# ── Public (browser-accessible) ──────────────────────────────────────────────
# Only needed if you want the browser to call the API directly (cross-origin).
# In the default setup, the browser uses same-origin proxy (/api/backend) so
# cookies work with middleware. Leave commented unless you know what you're doing.
# NEXT_PUBLIC_API_URL=https://api.myorg.com

