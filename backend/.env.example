# Application
GOKIL_APP_NAME=backend
GOKIL_ENV=development
GOKIL_DEBUG=true
GOKIL_HOST=127.0.0.1
GOKIL_PORT=8080

# Auth
JWT_SECRET=dev-secret-change-me

# Database (PostgreSQL)
GOKIL_DB_DRIVER=postgres
GOKIL_DB_HOST=localhost
GOKIL_DB_PORT=5432
GOKIL_DB_USER=backend
GOKIL_DB_PASSWORD=gokil
GOKIL_DB_NAME=backend
GOKIL_DB_DSN=postgres://backend:gokil@localhost:5432/backend?sslmode=disable
GOKIL_DB_MIGRATIONS_DIR=migrations

# Redis
GOKIL_REDIS_ENABLED=true
GOKIL_REDIS_HOST=localhost
GOKIL_REDIS_PORT=6379
GOKIL_REDIS_URL=redis://localhost:6379/0

# Storage (local or s3/MinIO)
GOKIL_STORAGE_PROVIDER=local
GOKIL_STORAGE_LOCAL_PATH=storage
# MinIO (S3-compatible) — uncomment for object storage:
# GOKIL_STORAGE_PROVIDER=s3
# GOKIL_STORAGE_BUCKET=myorg
# GOKIL_STORAGE_REGION=us-east-1
# GOKIL_STORAGE_ENDPOINT=localhost:9000
# GOKIL_STORAGE_ACCESS_KEY_ID=minioadmin
# GOKIL_STORAGE_SECRET_ACCESS_KEY=minioadmin
# GOKIL_STORAGE_BASE_URL=http://localhost:9000/myorg
# GOKIL_STORAGE_USE_SSL=false

# Seed admin (optional override)
# ADMIN_PASSWORD=changeme

# OCR service (PDF/image text extraction)
OCR_SERVICE_URL=http://localhost:8090
OCR_PORT=8090
OCR_LANG=ind+eng
