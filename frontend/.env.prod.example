# =============================================================================
# MyOrg Frontend — Production Environment
# =============================================================================
# Copy to .env.prod and fill in real values.
# =============================================================================

# Server-side: where Next.js SSR calls the backend.
# For Docker internal network: http://gokil:8080
# For cross-domain: https://api-himatris.heroflow.my.id
API_INTERNAL_URL=http://gokil:8080

# ── Public (browser-accessible) ──────────────────────────────────────────────
# Set to the backend's public domain so the browser calls it directly.
# NEXT_PUBLIC_USE_DIRECT_API=1 is REQUIRED for the browser to use this URL.
# Without it, the browser always uses same-origin proxy (/api/backend).
NEXT_PUBLIC_API_URL=https://api-himatris.heroflow.my.id
NEXT_PUBLIC_USE_DIRECT_API=1
